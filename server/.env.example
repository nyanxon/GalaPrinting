# ─── Application ────────────────────────────────────────────────────────────
# Environment: development | production
NODE_ENV=production

# Port the Express server listens on (Hostinger will assign a port)
PORT=3001

# ─── Database (Hostinger MySQL) ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_gala_printing
DB_USER=u123456789_admin
DB_PASSWORD=your_hostinger_db_password

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# IMPORTANT: Generate strong random secrets for production (openssl rand -hex 64)
JWT_ACCESS_SECRET=your_strong_access_secret_here
JWT_REFRESH_SECRET=your_strong_refresh_secret_here

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ─── File Uploads ─────────────────────────────────────────────────────────────
# PENTING untuk Hostinger: gunakan path ABSOLUT di luar folder project agar
# file tidak hilang saat git push / deploy ulang.
#
# Langkah setup di Hostinger:
#   1. File Manager → buat folder: /home/u<id>/persistent_uploads
#      Lalu buat subfolder di dalamnya: designs, payments, chat, avatars, products
#   2. hPanel → Node.js → Environment Variables → tambahkan:
#      UPLOAD_DIR=/home/u<id>/persistent_uploads
#   3. Restart app Node.js
#
# Untuk development lokal, path relatif tetap bisa dipakai:
#   UPLOAD_DIR=./uploads
UPLOAD_DIR=/home/u123456789/persistent_uploads

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend origin allowed to make cross-origin requests
# For single-domain setup on Hostinger, set this to your domain
CLIENT_ORIGIN=https://galaprintofficialbali.co.id

# ─── Security ────────────────────────────────────────────────────────────────
# bcrypt work factor (default 12; lower for faster tests, higher for production)
BCRYPT_ROUNDS=12
