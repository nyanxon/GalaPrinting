# ─── Application ────────────────────────────────────────────────────────────
# Environment: development | production
NODE_ENV=development

# Port the Express server listens on
PORT=3001

# ─── Database (XAMPP MySQL) ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gala_printing
DB_USER=root
DB_PASSWORD=

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# Generate strong random secrets for production (e.g. openssl rand -hex 64)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ─── File Uploads ─────────────────────────────────────────────────────────────
# Absolute or relative path where uploaded files are stored
UPLOAD_DIR=./uploads

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend origin allowed to make cross-origin requests
CLIENT_ORIGIN=http://localhost:5173

# ─── Security ────────────────────────────────────────────────────────────────
# bcrypt work factor (default 12; lower for faster tests, higher for production)
BCRYPT_ROUNDS=12
