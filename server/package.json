{
  "name": "gala-printing-server",
  "version": "1.0.0",
  "description": "Node.js/Express backend for Gala Printing",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node index.js",
    "migrate": "node src/db/migrate.js",
    "test": "vitest run",
    "build:frontend": "cd .. && npm install && npm run build",
    "build": "npm run build:frontend"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "resend": "^4.8.0",
    "socket.io": "^4.7.5",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "fast-check": "^4.7.0",
    "nodemon": "^3.1.3",
    "vitest": "^4.1.8"
  }
}
